# auto-poster: copy this file to .env (same folder) and fill in your own values.
# The posting script reads this .env regardless of cwd; never share the filled-in copy.

ZERNIO_API_KEY=
ZERNIO_API_URL=https://zernio.com/api/v1
# IANA timezone for scheduled posts (--mode customScheduled), e.g. America/New_York.
# Required for scheduling; shareNow ignores it.
ZERNIO_TIMEZONE=

# Connected account IDs: only the ones you have connected. Every key present here
# is a default posting target. Get paste-ready lines with
#   python3 .claude/skills/auto-poster/scripts/post_to_zernio.py --list-accounts
# (run from the project root after ZERNIO_API_KEY is filled in). IDs change on every
# OAuth reconnect, so re-run it when Zernio says "accounts do not belong to this user".
ZERNIO_ACCOUNT_INSTAGRAM=
ZERNIO_ACCOUNT_TIKTOK=
ZERNIO_ACCOUNT_YOUTUBE=
ZERNIO_ACCOUNT_LINKEDIN=
ZERNIO_ACCOUNT_FACEBOOK=
ZERNIO_ACCOUNT_THREADS=

# Optional: only needed for --mode addToQueue.
# ZERNIO_PROFILE_ID=
# ZERNIO_QUEUE_ID=
